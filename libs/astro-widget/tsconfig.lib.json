{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["node", "vite/client"],
    "rootDir": "src",
    "module": "esnext",
    "moduleResolution": "bundler",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "ignoreDeprecations": "6.0"
  },
  "exclude": [
    "out-tsc", "dist",
    "**/*.spec.ts", "**/*.test.ts", "**/*.test-d.ts",
    "vite.config.ts", "eslint.config.mjs", "src/test-setup.ts"
  ],
  "include": ["src/**/*.ts"]
}
