{
  "name": "@evanion/feature",
  "version": "0.0.1",
  "private": true,
  "description": "Feature toggles with dependencies and composite rules: turning one flag off turns off the flags that need it, and a parent's 25% rollout does not leak to 100% of its dependants.",
  "keywords": [
    "feature-flags",
    "feature-toggles",
    "rollout",
    "targeting",
    "dependencies",
    "typescript"
  ],
  "homepage": "https://github.com/Evanion/libraries/tree/main/libs/feature#readme",
  "bugs": {
    "url": "https://github.com/Evanion/libraries/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Evanion/libraries.git",
    "directory": "libs/feature"
  },
  "license": "MIT",
  "author": "Mikael Pettersson",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@evanion/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "conformance",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/*.test-d.*",
    "!src/test-setup.ts",
    "!src/lib/zones.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@evanion/doc-examples": "*"
  },
  "nx": {
    "targets": {
      "test": {
        "dependsOn": [
          "^build",
          "build",
          {
            "projects": [
              "@evanion/react-feature"
            ],
            "target": "build"
          }
        ]
      }
    }
  }
}
