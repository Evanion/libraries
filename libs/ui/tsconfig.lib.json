{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // `dist` belongs to the vite build, which empties it and writes the
    // published declarations through vite-plugin-dts. tsc runs over this
    // config only to type-check, so its emit goes to a throwaway directory.
    "outDir": "out-tsc/lib",
    // `client.ts` reaches the DOM; the components only render elements.
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["node", "vite/client"],
    "rootDir": "src",
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "tsBuildInfoFile": "out-tsc/lib/tsconfig.lib.tsbuildinfo",
    "ignoreDeprecations": "6.0"
  },
  "exclude": [
    "out-tsc",
    "dist",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.spec.tsx",
    "**/*.test.tsx",
    "vite.config.ts",
    "src/**/*.test-d.ts",
    "src/**/*.test-d.tsx",
    "eslint.config.mjs",
    "src/test-setup.ts"
  ],
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "../../tools/doc-examples"
    }
  ]
}
