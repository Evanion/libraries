{
  "name": "@evanion/docs",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "docs",
    "tags": [
      "scope:docs",
      "type:app"
    ],
    "targets": {
      "testing-data": {
        "command": "node tools/test-statistics.mjs",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "dependsOn": [
          {
            "projects": "libs/*",
            "target": "test"
          }
        ],
        "inputs": [
          "{projectRoot}/tools/test-statistics.mjs",
          "{projectRoot}/tools/statistics.mjs",
          "{projectRoot}/content/**/*.mdx",
          "{workspaceRoot}/tools/repo-checks/src/*.test.ts",
          "{workspaceRoot}/tools/repo-checks/src/*-allowance.json",
          "{workspaceRoot}/libs/acl/SECURITY.md",
          "{workspaceRoot}/libs/acl/src/security/tier1-prevented.test.ts",
          "{workspaceRoot}/nx.json",
          {
            "dependentTasksOutputFiles": "**/*.json"
          }
        ],
        "outputs": [
          "{projectRoot}/components/testing/statistics.json"
        ]
      },
      "build": {
        "dependsOn": [
          "^build",
          "testing-data"
        ],
        "outputs": [
          "{projectRoot}/.next",
          "{projectRoot}/out"
        ]
      },
      "test": {
        "dependsOn": [
          "^build",
          "testing-data"
        ]
      },
      "lint": {
        "dependsOn": [
          "testing-data"
        ]
      }
    }
  },
  "scripts": {
    "postbuild": "node tools/md-siblings.mjs && pagefind --site out --output-path out/_pagefind"
  },
  "dependencies": {
    "@evanion/acl": "*",
    "@evanion/baize-ui": "*",
    "@evanion/compose": "*",
    "@evanion/luhn": "*",
    "@evanion/react-acl": "*",
    "@evanion/react-widget": "*",
    "@evanion/token": "*",
    "@evanion/urn": "*",
    "mermaid": "^11.17.2",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
