{
  "name": "@evanion/docs",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "docs",
    "tags": [
      "scope:docs",
      "type:app"
    ],
    "targets": {
      "testing-data": {
        "command": "node tools/test-statistics.mjs",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "dependsOn": [
          {
            "projects": "libs/*",
            "target": "test"
          }
        ],
        "inputs": [
          "{projectRoot}/tools/test-statistics.mjs",
          "{projectRoot}/tools/statistics.mjs",
          "{projectRoot}/content/**/*.mdx",
          "{workspaceRoot}/tools/repo-checks/src/*.test.ts",
          "{workspaceRoot}/tools/repo-checks/src/*-allowance.json",
          "{workspaceRoot}/libs/acl/SECURITY.md",
          "{workspaceRoot}/libs/acl/src/security/tier1-prevented.test.ts",
          "{workspaceRoot}/nx.json",
          {
            "dependentTasksOutputFiles": "**/*.json"
          }
        ],
        "outputs": [
          "{projectRoot}/components/testing/statistics.json"
        ]
      },
      "behaviour-data": {
        "command": "node tools/behaviour-data.mjs",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "inputs": [
          "{projectRoot}/tools/behaviour-data.mjs",
          "{projectRoot}/tools/libraries.mjs",
          "{projectRoot}/tools/code-classes.mjs",
          "{workspaceRoot}/tools/doc-examples/src/behaviours.mjs",
          "{workspaceRoot}/libs/*/src/**/*.ts",
          "{workspaceRoot}/libs/*/src/**/*.tsx",
          "{workspaceRoot}/nx.json"
        ],
        "outputs": [
          "{projectRoot}/components/api/behaviour",
          "{projectRoot}/public/behaviour"
        ]
      },
      "widget-renders": {
        "command": "node tools/widget-renders.mjs",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "inputs": [
          "{projectRoot}/tools/widget-renders.mjs",
          "{workspaceRoot}/tools/doc-examples/src/regions.mjs",
          "{workspaceRoot}/tools/doc-examples/src/examples-file.mjs",
          "{workspaceRoot}/libs/astro-widget/docs/examples.md",
          "{workspaceRoot}/libs/astro-widget/src/**/*",
          "{workspaceRoot}/libs/astro-widget/examples/**/*",
          "{workspaceRoot}/libs/widget/src/**/*",
          {
            "externalDependencies": [
              "astro",
              "vite"
            ]
          }
        ],
        "outputs": [
          "{projectRoot}/components/astro-widget/renders.json"
        ]
      },
      "archives": {
        "command": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/write-archives.mjs",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": false,
        "outputs": [
          "{projectRoot}/content/versions.json"
        ]
      },
      "code-classes": {
        "command": "node tools/write-code-classes.mjs",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "inputs": [
          "{projectRoot}/tools/write-code-classes.mjs",
          "{projectRoot}/tools/code-classes.mjs",
          {
            "externalDependencies": [
              "shiki",
              "@shikijs/transformers"
            ]
          }
        ],
        "outputs": [
          "{projectRoot}/public/code-classes.css"
        ]
      },
      "build": {
        "dependsOn": [
          "^build",
          "testing-data",
          "behaviour-data",
          "widget-renders",
          "archives",
          "code-classes"
        ],
        "inputs": [
          "default",
          "^default",
          {
            "externalDependencies": [
              "next"
            ]
          },
          {
            "dependentTasksOutputFiles": "**/*.d.ts",
            "transitive": true
          },
          {
            "dependentTasksOutputFiles": "**/content/versions.json"
          }
        ],
        "outputs": [
          "{projectRoot}/.next",
          "{projectRoot}/out"
        ]
      },
      "test": {
        "dependsOn": [
          "^build",
          "testing-data",
          "behaviour-data",
          "widget-renders"
        ]
      },
      "lint": {
        "dependsOn": [
          "testing-data",
          "widget-renders"
        ]
      },
      "dev": {
        "dependsOn": [
          "archives",
          "code-classes"
        ]
      }
    }
  },
  "scripts": {
    "postbuild": "node tools/md-siblings.mjs && node tools/write-redirects.mjs && node tools/write-sitemap.mjs && pagefind --site out --output-path out/_pagefind"
  },
  "dependencies": {
    "@evanion/acl": "*",
    "@evanion/baize-ui": "*",
    "@evanion/compose": "*",
    "@evanion/luhn": "*",
    "@evanion/react-acl": "*",
    "@evanion/react-widget": "*",
    "@evanion/token": "*",
    "@evanion/urn": "*",
    "mermaid": "^12.1.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@evanion/doc-examples": "*",
    "@shikijs/themes": "3.23.0",
    "@shikijs/transformers": "3.23.0",
    "@shikijs/twoslash": "3.23.0",
    "hast-util-from-html": "2.0.3",
    "hast-util-sanitize": "5.0.2",
    "hast-util-to-jsx-runtime": "2.3.6",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "shiki": "3.23.0",
    "twoslash": "0.3.9",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0"
  }
}
