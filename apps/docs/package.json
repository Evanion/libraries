{
  "name": "@evanion/docs",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "docs",
    "tags": [
      "scope:docs",
      "type:app"
    ],
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/.next",
          "{projectRoot}/out"
        ]
      }
    }
  },
  "scripts": {
    "postbuild": "node tools/md-siblings.mjs && pagefind --site out --output-path out/_pagefind"
  },
  "dependencies": {
    "@evanion/acl": "*",
    "@evanion/baize-ui": "*",
    "@evanion/compose": "*",
    "@evanion/luhn": "*",
    "@evanion/react-acl": "*",
    "@evanion/react-widget": "*",
    "@evanion/token": "*",
    "@evanion/urn": "*",
    "mermaid": "^11.17.2",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
