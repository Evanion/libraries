{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["@react-router/node", "vite/client", "node"],
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    // `./+types/<route>` in a route module resolves into the typegen output,
    // which React Router writes to .react-router/types mirroring the app tree.
    // `rootDirs` is what merges the two trees for module resolution; without it
    // every route module's type import fails, and with `noImplicitAny` off it
    // would instead resolve to `any` and check nothing.
    "rootDirs": [".", "./.react-router/types"],
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo"
  },
  "include": [
    ".react-router/types/**/*",
    "app/**/*.ts",
    "app/**/*.tsx",
    "**/.server/**/*.ts",
    "**/.server/**/*.tsx",
    "**/.client/**/*.ts",
    "**/.client/**/*.tsx"
  ],
  "exclude": [
    "out-tsc",
    "dist",
    "build",
    "tests/**/*",
    "vite.config.mts",
    "eslint.config.mjs"
  ],
  "references": [
    {
      "path": "../../libs/compose/tsconfig.lib.json"
    },
    {
      "path": "../../libs/widget/tsconfig.lib.json"
    },
    {
      "path": "../../libs/baize-ui/tsconfig.lib.json"
    }
  ]
}
