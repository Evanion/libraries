---
import { classNames } from '@evanion/baize-ui/tokens';

import AvailabilityPill from '../../components/AvailabilityPill.astro';
import BoxArt from '../../components/BoxArt.astro';
import MechanismTags from '../../components/MechanismTags.astro';
import StatLine from '../../components/StatLine.astro';
import { formatPrice, gameLadderClass } from '../../lib/catalogue.js';
import { regionCtx } from '../ctx.js';

interface Props {
  /** Which game to feature, as a full game urn. */
  urn: string;
  /** One line above the title, saying why this game is here. */
  lede: string;
  ctx?: Record<string, unknown>;
}

const { urn, lede, ctx } = Astro.props;
const { games } = regionCtx(ctx);
const game = games.find((candidate) => candidate.urn === urn);
---

{
  /* The editor picks the game by urn; the catalogue data behind it comes from
     ctx. A urn naming nothing renders nothing rather than breaking the page: the
     catalogue can drop a title without the landing page being republished. */
}
{
  game && (
    <div class="feature">
      <div>
        <p class="feature__lede">{lede}</p>
        <div class="baize-section-header">
          <h1
            class={classNames(
              'baize-title',
              'baize-title--size-xl',
              gameLadderClass(game),
            )}
          >
            {game.title}
          </h1>
          <AvailabilityPill availability={game.availability} />
        </div>
        <MechanismTags mechanisms={game.mechanisms} />
        <div class="feature__stats">
          <StatLine
            players={game.players}
            playtime={game.playtime}
            complexity={game.complexity}
            size="lg"
          />
        </div>
        <div class="feature__buy">
          <span class="baize-figure baize-figure--size-lg">
            {formatPrice(game.price)}
          </span>
          <a
            class="baize-button baize-button--variant-primary"
            href={`/g/${game.urn}`}
          >
            See the game
          </a>
        </div>
      </div>
      <BoxArt title={game.title} urn={game.urn} />
    </div>
  )
}
