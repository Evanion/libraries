---
interface Props {
  heading?: string;
  /** One entry per paragraph. */
  paragraphs: string[];
}

const { heading, paragraphs } = Astro.props;
---

<div>
  {heading && <h2 class="baize-title baize-title--size-md">{heading}</h2>}
  {
    paragraphs.map((paragraph) => (
      <p
        class="baize-text baize-text--tone-lichen baize-text--size-base baize-text--measured"
      >
        {paragraph}
      </p>
    ))
  }
</div>
