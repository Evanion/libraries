---
interface Props {
  heading: string;
  body: string;
  href: string;
  label: string;
}

const { heading, body, href, label } = Astro.props;
---

<h2 class="baize-panel__heading">{heading}</h2>
<p class="baize-text baize-text--tone-lichen baize-text--size-sm">{body}</p>
<a class="baize-button baize-button--variant-standard" href={href}>{label}</a>
