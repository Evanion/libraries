---
import { weightSteps } from '../lib/catalogue.js';

interface Props {
  /** Complexity, 1 to 5. */
  weight: number;
}

const { weight } = Astro.props;
const filled = weightSteps(weight);
const cells = [1, 2, 3, 4, 5];
---

{/* role="img" with the rating in the label, because five coloured cells say
    nothing to a screen reader and the figure beside them is the real content. */}
<div
  class="baize-weight"
  role="img"
  aria-label={`weight ${weight.toFixed(1)} of 5`}
>
  {
    cells.map((step) => (
      <span
        class="baize-weight__cell"
        data-step={step <= filled ? String(step) : undefined}
      />
    ))
  }
</div>
