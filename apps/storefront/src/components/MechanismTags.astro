---
import { classNames } from '@evanion/baize-ui/tokens';

import { mechanismHueClass, mechanismSlug } from '../lib/catalogue.js';

interface Props {
  mechanisms: string[];
}

const { mechanisms } = Astro.props;
---

{/* The library's `TagRow` of `MechanismTag`s, as Astro, each tag wrapped in the
    link to its category.

    Each tag carries its own hue rather than inheriting the card's: a game's second
    mechanism belongs to its own family, and the title above already says which
    family leads. The link is outside the tag, because the tag is the shape the
    stylesheet draws and a link has no business carrying it. */}
<div class="baize-tag-row">
  {
    mechanisms.map((mechanism) => (
      <a class="tag-link" href={`/c/${mechanismSlug(mechanism)}`}>
        <span
          class={classNames(
            'baize-mechanism-tag',
            mechanismHueClass(mechanism),
          )}
        >
          {mechanism}
        </span>
      </a>
    ))
  }
</div>
