---
import { mechanismSlug } from '../lib/catalogue.js';

interface Props {
  mechanisms: string[];
}

const { mechanisms } = Astro.props;
---

{/* The library's `TagRow` of `MechanismTag`s, as Astro, each tag wrapped in the
    link to its category.

    No hue on a tag. Mechanism is still a channel -- the shape, the wording and the
    link to the category are all here -- but the card spends its one saturated
    colour on the complexity ladder in the title above. The link is outside the tag,
    because the tag is the shape the stylesheet draws and a link has no business
    carrying it. */}
<div class="baize-tag-row">
  {
    mechanisms.map((mechanism) => (
      <a class="tag-link" href={`/c/${mechanismSlug(mechanism)}`}>
        <span class="baize-mechanism-tag">{mechanism}</span>
      </a>
    ))
  }
</div>
