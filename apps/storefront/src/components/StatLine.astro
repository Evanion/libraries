---
import { classNames, modifier } from '@evanion/baize-ui/tokens';

import {
  complexityStop,
  complexityTierName,
  formatComplexity,
} from '../lib/catalogue.js';
import ComplexityRamp from './ComplexityRamp.astro';

interface Props {
  players: string;
  playtime: string;
  complexity: number;
  /** `lg` sets the figures at display size, for the landing feature. */
  size?: 'base' | 'lg';
}

const { players, playtime, complexity, size = 'base' } = Astro.props;
const stop = complexityStop(complexity);
---

{/* The library's `StatLine` and `Stat`, as Astro. Same class names, same document
    order, same markup: `baize-contract.astro.test.ts` renders this against the
    React pair for the same props and fails on a divergence.

    Each cell is a div and not a paragraph: the complexity cell holds the ramp, and a
    parser closes an open `<p>` when a `<div>` starts inside it, which silently
    lifts the ramp out of its grid column.

    The tier word leads the complexity cell and the rating follows it in the label.
    The word is what a shopper reads and what carries the ladder's meaning without
    colour; the number is still there for anyone comparing two Midweight games. */}
<div class={classNames('baize-statline', modifier('baize-statline', 'size', size))}>
  <div class="baize-stat">
    <span class="baize-stat__figure baize-figure">{players}</span>
    <span class="baize-stat__label">players</span>
  </div>
  <div class="baize-stat">
    <span class="baize-stat__figure baize-figure">{playtime}</span>
    <span class="baize-stat__label">playtime</span>
  </div>
  <div class="baize-stat">
    <span class="baize-stat__figure baize-figure">
      {complexityTierName(complexity)}
    </span>
    <span class="baize-stat__label">
      complexity {formatComplexity(complexity)}
    </span>
    {stop && <ComplexityRamp label={`complexity ${complexity.toFixed(1)} of 5`} stop={stop} />}
  </div>
</div>
