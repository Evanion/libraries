---
import {
  classNames,
  modifier,
  type ComplexityStop,
} from '@evanion/baize-ui/tokens';

interface Props {
  /** How many pips are filled, and therefore which ramp stops they take. */
  stop: ComplexityStop;
  /** The accessible name, already worded: `complexity 2.4 of 5`. */
  label: string;
}

const { stop, label } = Astro.props;
const pips = [1, 2, 3, 4, 5] as const;
---

{/* The library's `ComplexityRamp`, as Astro. `role="img"` with the rating in the
    label, because five coloured pips say nothing to a screen reader and the
    figure beside them is the real content. */}
<span aria-label={label} class="baize-complexity" role="img">
  {
    pips.map((pip) => (
      <span
        class={classNames(
          'baize-complexity__pip',
          pip <= stop && modifier('baize-complexity__pip', 'stop', pip),
        )}
      />
    ))
  }
</span>
