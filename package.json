{
  "name": "@evanion/open-source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "commit": "cz",
    "commit:check": "commitlint --edit",
    "prepare": "husky",
    "pre-commit:with-tests": "cp .husky/pre-commit .husky/pre-commit.backup && cp .husky/pre-commit-with-tests .husky/pre-commit",
    "pre-commit:restore": "cp .husky/pre-commit.backup .husky/pre-commit && rm .husky/pre-commit.backup",
    "verify:packaging": "node scripts/verify-packaging.mjs"
  },
  "private": true,
  "overrides": {
    "dompurify": "^3.4.13",
    "nextra": {
      "zod": "4.3.0"
    },
    "nextra-theme-docs": {
      "zod": "4.3.0"
    }
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@next/eslint-plugin-next": "^15.2.4",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/next": "23.1.1",
    "@nx/react": "23.1.1",
    "@nx/vite": "23.1.1",
    "@nx/vitest": "23.1.1",
    "@nx/web": "23.1.1",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.1",
    "@swc/helpers": "0.5.23",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.9",
    "@vitest/ui": "4.1.9",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.5.4",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.8.0",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "nx": "23.1.1",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "4.1.9"
